{
  "name": "video-editor-api",
  "version": "1.0.0",
  "private": true,
  "description": "Video editor backend: upload, thumbnails, audio extraction and resizing with FFmpeg.",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cluster": "tsx watch src/cluster.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:cluster": "node dist/src/cluster.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
